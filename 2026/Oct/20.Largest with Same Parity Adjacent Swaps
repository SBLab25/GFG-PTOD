class Solution {
    public ArrayList<Integer> lexicographicallyLargest(int[] arr) {
        // code here
        int n = arr.length;
        ArrayList<Integer> result = new ArrayList<>();

        int i = 0;

        while (i < n) {
            int j = i;

            while (j + 1 < n &&
                arr[j] % 2 == arr[j + 1] % 2) {
                j++;
            }

            ArrayList<Integer> group = new ArrayList<>();

            for (int k = i; k <= j; k++) {
                group.add(arr[k]);
            }

            group.sort(Collections.reverseOrder());
            result.addAll(group);

            i = j + 1;
        }
        return result;
    }
}