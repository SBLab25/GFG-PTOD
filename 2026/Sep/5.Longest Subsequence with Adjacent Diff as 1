class Solution {
    public int longestSubseq(int[] arr) {
        // code here
        if(arr==null || arr.length==0){
            return 0;
        }
        
        Map<Integer, Integer> dp= new HashMap<>();
        int maxLen=0;
        
        for(int num:arr){
            int lenFL=dp.getOrDefault(num-1,0);
            int lenFM=dp.getOrDefault(num+1,0);
            
            int curLen=Math.max(lenFL,lenFM)+1;
            
            dp.put(num,Math.max(dp.getOrDefault(num,0), curLen));
            
            maxLen=Math.max(maxLen, curLen);
        }
        
        return maxLen;
    }
}
